# --- Chain access ---
# Supported CHAIN_IDs: 11155111 (Sepolia), 80002 (Polygon Amoy, DIMO's chain),
# 421614 (Arbitrum Sepolia, WeatherXM's chain). All clear-signing-capable.
CHAIN_ID=11155111
RPC_URL=https://rpc-amoy.polygon.technology
# (legacy alias still accepted: SEPOLIA_RPC_URL)

# --- Deployed contracts (from the Foundry deploy output) ---
DISTRIBUTOR_ADDRESS=0xYOUR_DISTRIBUTOR
REWARD_TOKEN_ADDRESS=0xYOUR_RWRD_TOKEN

# --- Operator ---
# Address derived at DERIVATION_PATH on the Speculos seed. This is who holds
# claimable rewards and approves the claim on-device. The agent never has its key.
OPERATOR_ADDRESS=0xOPERATOR_FROM_SPECULOS
# Where claimed RWRD goes. Defaults to OPERATOR_ADDRESS if unset.
# CLAIM_RECIPIENT=0x...

# --- Decision policy (the "intelligence" layer) ---
FLOOR_RWRD=100        # only claim when claimable >= this many RWRD
CEILING_GWEI=50       # only claim when maxFeePerGas <= this many gwei

# --- Signing device (Speculos) ---
SPECULOS_URL=http://localhost:5000
DERIVATION_PATH=44'/60'/0'/0/0
DEVICE_MODEL=flex     # nanoS | nanoSP | nanoX | stax | flex

# --- Loop ---
POLL_INTERVAL_MS=15000
