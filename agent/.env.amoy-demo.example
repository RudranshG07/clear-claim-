# Zero-deploy instant demo — points at the LIVE Clear-Claim contracts on Polygon
# Amoy. The Speculos default seed derives the same operator (0xf35e…13Db), which
# already has rewards accrued, so you can see the clear-signed claim WITHOUT
# deploying anything or holding any key.
#
#   cp agent/.env.amoy-demo.example agent/.env
#   (start Speculos on :5005, then `npm start`)
#
# Approve on http://localhost:5005 — the device shows "Claim 142.5 RWRD to 0x…,
# Network Polygon Amoy". Holding to sign broadcasts (one-shot until re-accrued);
# rejecting just shows the render (repeatable).

CHAIN_ID=80002
RPC_URL=https://rpc-amoy.polygon.technology

DISTRIBUTOR_ADDRESS=0x9C1c395C0B1B15eF4DE0B618597b1e221b7E2128
REWARD_TOKEN_ADDRESS=0x25701aCCf2B9774afE71f43f4e010Eb82a0A7444

OPERATOR_ADDRESS=0xf35ec83BDcd18BFF5412Df78362557E0F19f13Db
CLAIM_RECIPIENT=0xf35ec83BDcd18BFF5412Df78362557E0F19f13Db

FLOOR_RWRD=100
CEILING_GWEI=200

SPECULOS_URL=http://localhost:5005
