# Sepolia RPC endpoint (Alchemy / Infura / public node)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Deployer key — funds deploy + reward pool + accrual. NOT the signing key.
# Must hold Sepolia ETH (use a faucet). Operator signing happens on Speculos.
DEPLOYER_PRIVATE_KEY=0xYOUR_FUNDED_DEPLOYER_KEY

# Operator address whose Ledger/Speculos approves claims.
# This is the address derived at 44'/60'/0'/0/0 on the Speculos seed.
OPERATOR_ADDRESS=0xOPERATOR_FROM_SPECULOS

# Optional: starting reward to accrue (wei). Default 142.5e18.
INITIAL_ACCRUAL=142500000000000000000

# Optional: Etherscan key for source verification.
ETHERSCAN_API_KEY=
